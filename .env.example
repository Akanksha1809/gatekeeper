# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Application ---
GATEKEEPER_ENV=development
GATEKEEPER_LOG_LEVEL=INFO
GATEKEEPER_LOG_FORMAT=json

# --- Admin auth (HTTP Basic for /admin/*) ---
# Change these before exposing the gateway beyond localhost.
GATEKEEPER_ADMIN_USERNAME=admin
GATEKEEPER_ADMIN_PASSWORD=change-me-admin-password

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=change-me-postgres-password
GATEKEEPER_DATABASE_URL=postgresql+asyncpg://gatekeeper:change-me-postgres-password@postgres:5432/gatekeeper

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
GATEKEEPER_REDIS_URL=redis://redis:6379/0

# --- Rate limiting ---
# fail_open: allow traffic through if Redis is unreachable (availability-biased)
# fail_closed: reject traffic if Redis is unreachable (safety-biased, default)
GATEKEEPER_RATE_LIMIT_FAIL_MODE=fail_closed

# --- Config files ---
GATEKEEPER_ROUTES_CONFIG=/app/config/routes.yaml
GATEKEEPER_POLICIES_CONFIG=/app/config/policies.yaml

# --- Demo upstream ports (used by docker-compose) ---
HEALTHY_SERVICE_PORT=9001
SLOW_SERVICE_PORT=9002
FLAKY_SERVICE_PORT=9003

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
